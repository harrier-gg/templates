{
  "templates": [
    {
      "schemaVersion": 1,
      "id": "minecraft-java",
      "abstract": true,
      "game": {
        "id": "minecraft-java",
        "name": "Minecraft: Java Edition"
      },
      "install": {
        "method": "image"
      },
      "runtime": {
        "image": "itzg/minecraft-server:java25",
        "java": {
          "8": "itzg/minecraft-server:java8",
          "11": "itzg/minecraft-server:java11",
          "16": "itzg/minecraft-server:java16",
          "17": "itzg/minecraft-server:java17",
          "21": "itzg/minecraft-server:java21",
          "25": "itzg/minecraft-server:java25"
        },
        "env": {
          "EULA": "TRUE",
          "MEMORY": "",
          "JVM_XX_OPTS": "-XX:MaxRAMPercentage=75.0"
        }
      },
      "versions": {
        "provider": "mojang"
      },
      "ports": [
        {
          "name": "game",
          "container": 25565,
          "protocol": "tcp"
        }
      ],
      "config": [
        {
          "key": "version",
          "label": {
            "en": "Minecraft version",
            "de": "Minecraft-Version"
          },
          "type": "version",
          "default": "LATEST",
          "env": "VERSION"
        },
        {
          "key": "memory",
          "label": {
            "en": "Memory (MB)",
            "de": "Arbeitsspeicher (MB)"
          },
          "type": "integer",
          "default": 2048,
          "min": 1024,
          "max": 32768,
          "limit": "memory"
        },
        {
          "key": "sleepAfter",
          "label": {
            "en": "Sleep after (minutes without players, 0 = never)",
            "de": "Schlafen nach (Minuten ohne Spieler, 0 = nie)"
          },
          "type": "integer",
          "default": 15,
          "min": 0,
          "max": 1440,
          "limit": "sleep"
        }
      ],
      "files": [
        {
          "path": "server.properties",
          "description": {
            "en": "Most server settings: difficulty, game mode, max. players, whitelist, view distance … Since Minecraft 1.21.9, PvP and some others are game rules: set them in the console, e.g. /gamerule pvp false.",
            "de": "Die meisten Servereinstellungen: Schwierigkeit, Spielmodus, max. Spieler, Whitelist, Sichtweite … Seit Minecraft 1.21.9 sind PvP und einige andere Spielregeln: Stelle sie in der Konsole ein, z. B. /gamerule pvp false."
          }
        }
      ],
      "lifecycle": {
        "ready": "Done \\([0-9.]+s\\)!",
        "stopTimeoutSecs": 60
      },
      "capabilities": {
        "console": {
          "via": "stdin"
        },
        "players": {
          "protocol": "minecraft"
        },
        "sleep": {
          "wake": "minecraft"
        },
        "backup": {
          "before": [
            "save-off",
            "save-all flush"
          ],
          "ready": "^\\[[0-9:]{8}(\\] \\[Server thread/INFO\\]| INFO\\]): (System chat: )?Saved the game$",
          "after": [
            "save-on"
          ],
          "exclude": [
            "libraries",
            "versions",
            ".cache",
            "cache",
            ".fabric",
            "*.jar"
          ]
        }
      }
    },
    {
      "schemaVersion": 1,
      "id": "minecraft-java/fabric",
      "extends": "minecraft-java",
      "variant": {
        "id": "fabric",
        "name": "Fabric",
        "description": {
          "en": "Lightweight mod loader for Fabric mods.",
          "de": "Leichtgewichtiger Mod-Loader für Fabric-Mods."
        }
      },
      "runtime": {
        "env": {
          "TYPE": "FABRIC"
        }
      },
      "versions": {
        "provider": "fabric"
      },
      "content": [
        {
          "kind": "mod",
          "label": {
            "en": "Mods",
            "de": "Mods"
          },
          "path": "mods",
          "sources": [
            {
              "provider": "modrinth",
              "type": "mod",
              "loader": "fabric"
            }
          ]
        }
      ],
      "share": {
        "format": "mrpack",
        "loader": "fabric-loader"
      }
    },
    {
      "schemaVersion": 1,
      "id": "minecraft-java/modrinth-modpack",
      "extends": "minecraft-java",
      "variant": {
        "id": "modrinth-modpack",
        "name": "Modrinth modpack",
        "description": {
          "en": "Any modpack from Modrinth (Fabric, Forge, NeoForge, Quilt). The server installs its loader and server mods itself.",
          "de": "Ein beliebiges Modpack von Modrinth (Fabric, Forge, NeoForge, Quilt). Der Server installiert Loader und Server-Mods selbst."
        }
      },
      "runtime": {
        "env": {
          "TYPE": "MODRINTH"
        }
      },
      "config": [
        {
          "key": "modpack",
          "label": {
            "en": "Modpack (name or link from modrinth.com)",
            "de": "Modpack (Name oder Link von modrinth.com)"
          },
          "type": "modpack",
          "default": "adrenaserver",
          "env": "MODRINTH_MODPACK"
        },
        {
          "key": "version",
          "label": {
            "en": "Minecraft version",
            "de": "Minecraft-Version"
          },
          "type": "version",
          "default": "LATEST",
          "env": "VERSION"
        },
        {
          "key": "memory",
          "label": {
            "en": "Memory (MB)",
            "de": "Arbeitsspeicher (MB)"
          },
          "type": "integer",
          "default": 4096,
          "min": 2048,
          "max": 32768,
          "limit": "memory"
        },
        {
          "key": "sleepAfter",
          "label": {
            "en": "Sleep after (minutes without players, 0 = never)",
            "de": "Schlafen nach (Minuten ohne Spieler, 0 = nie)"
          },
          "type": "integer",
          "default": 15,
          "min": 0,
          "max": 1440,
          "limit": "sleep"
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "minecraft-java/paper",
      "extends": "minecraft-java",
      "variant": {
        "id": "paper",
        "name": "Paper",
        "description": {
          "en": "Fast server with plugin support (Bukkit/Paper API).",
          "de": "Schneller Server mit Plugin-Unterstützung (Bukkit/Paper-API)."
        }
      },
      "runtime": {
        "env": {
          "TYPE": "PAPER"
        }
      },
      "versions": {
        "provider": "papermc"
      },
      "content": [
        {
          "kind": "plugin",
          "label": {
            "en": "Plugins",
            "de": "Plugins"
          },
          "path": "plugins",
          "sources": [
            {
              "provider": "modrinth",
              "type": "plugin",
              "loader": "paper"
            },
            {
              "provider": "hangar",
              "platform": "PAPER"
            }
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "minecraft-java/vanilla",
      "extends": "minecraft-java",
      "variant": {
        "id": "vanilla",
        "name": "Vanilla",
        "description": {
          "en": "The official server from Mojang.",
          "de": "Der offizielle Server von Mojang."
        }
      },
      "runtime": {
        "env": {
          "TYPE": "VANILLA"
        }
      }
    },
    {
      "schemaVersion": 1,
      "id": "valheim/vanilla",
      "game": {
        "id": "valheim",
        "name": "Valheim"
      },
      "variant": {
        "id": "vanilla",
        "name": "Vanilla",
        "description": {
          "en": "A brutal exploration and survival game for 1-10 players, set in a procedurally-generated purgatory inspired by viking culture."
        }
      },
      "install": {
        "method": "script",
        "image": "ghcr.io/parkervcp/installers:debian",
        "entrypoint": "bash",
        "script": "#!/bin/bash\n# steamcmd Base Installation Script\n#\n# Server Files: /mnt/server\n# Image to install with is 'ghcr.io/parkervcp/installers:debian'\n\n##\n#\n# Variables\n# STEAM_USER, STEAM_PASS, STEAM_AUTH - Steam user setup. If a user has 2fa enabled it will most likely fail due to timeout. Leave blank for anon install.\n# WINDOWS_INSTALL - if it's a windows server you want to install set to 1\n# SRCDS_APPID - steam app id found here - https://developer.valvesoftware.com/wiki/Dedicated_Servers_List\n# SRCDS_BETAID - beta branch of a steam app. Leave blank to install normal branch\n# SRCDS_BETAPASS - password for a beta branch should one be required during private or closed testing phases.. Leave blank for no password.\n# INSTALL_FLAGS - Any additional SteamCMD  flags to pass during install.. Keep in mind that steamcmd auto update process in the docker image might overwrite or ignore these when it performs update on server boot.\n# AUTO_UPDATE - Adding this variable to the egg allows disabling or enabling automated updates on boot. Boolean value. 0 to disable and 1 to enable.\n#\n ##\n\n# Install packages. Default packages below are not required if using our existing install image thus speeding up the install process.\napt -y update\napt -y --no-install-recommends install curl lib32gcc-s1 ca-certificates\n\n## just in case someone removed the defaults.\nif [[ \"${STEAM_USER}\" == \"\" ]] || [[ \"${STEAM_PASS}\" == \"\" ]]; then\n    echo -e \"steam user is not set.\\n\"\n    echo -e \"Using anonymous user.\\n\"\n    STEAM_USER=anonymous\n    STEAM_PASS=\"\"\n    STEAM_AUTH=\"\"\nelse\n    echo -e \"user set to ${STEAM_USER}\"\nfi\n\n## download and install steamcmd\ncd /tmp\nmkdir -p /mnt/server/steamcmd\ncurl -sSL -o steamcmd.tar.gz https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz\ntar -xzvf steamcmd.tar.gz -C /mnt/server/steamcmd\nmkdir -p /mnt/server/steamapps # Fix steamcmd disk write error when this folder is missing\ncd /mnt/server/steamcmd\n\n# SteamCMD fails otherwise for some reason, even running as root.\n# This is changed at the end of the install process anyways.\nchown -R root:root /mnt\nexport HOME=/mnt/server\n\n## install game using steamcmd\n./steamcmd.sh +force_install_dir /mnt/server +login ${STEAM_USER} ${STEAM_PASS} ${STEAM_AUTH} $( [[ \"${WINDOWS_INSTALL}\" == \"1\" ]] && printf %s '+@sSteamCmdForcePlatformType windows' ) +app_update ${SRCDS_APPID} $( [[ -z ${SRCDS_BETAID} ]] || printf %s \"-beta ${SRCDS_BETAID}\" ) $( [[ -z ${SRCDS_BETAPASS} ]] || printf %s \"-betapassword ${SRCDS_BETAPASS}\" ) ${INSTALL_FLAGS} validate +quit ## other flags may be needed depending on install. looking at you cs 1.6\n\n## set up 32 bit libraries\nmkdir -p /mnt/server/.steam/sdk32\ncp -v linux32/steamclient.so ../.steam/sdk32/steamclient.so\n\n## set up 64 bit libraries\nmkdir -p /mnt/server/.steam/sdk64\ncp -v linux64/steamclient.so ../.steam/sdk64/steamclient.so"
      },
      "runtime": {
        "image": "ghcr.io/parkervcp/games:valheim",
        "mountPath": "/home/container",
        "startup": "./valheim_server.x86_64 -nographics -batchmode -name \"{{SERVER_NAME}}\" -port {{SERVER_PORT}} -world \"{{WORLD}}\" -password \"{{PASSWORD}}\" -public {{PUBLIC_SERVER}} -saveinterval {{BACKUP_INTERVAL}} -backups {{BACKUP_COUNT}} -backupshort {{BACKUP_SHORTTIME}} -backuplong {{BACKUP_LONGTIME}} $( [[ {{ENABLE_CROSSPLAY}} -eq 1 ]] && echo \" -crossplay \") > >(sed -uE \"{{CONSOLE_FILTER}}\")",
        "env": {
          "CONSOLE_FILTER": "/^\\(Filename:.*Line:[[:space:]]+[[:digit:]]+\\)$/d; /^([[:space:]]+)?$/d",
          "LD_LIBRARY_PATH": "./linux64",
          "SRCDS_APPID": "896660"
        }
      },
      "ports": [
        {
          "name": "game",
          "container": 2456,
          "protocol": "udp",
          "offset": 0,
          "samePort": true
        },
        {
          "name": "query",
          "container": 2457,
          "protocol": "udp",
          "offset": 1,
          "samePort": true
        }
      ],
      "config": [
        {
          "key": "autoUpdate",
          "label": {
            "en": "Auto Update"
          },
          "type": "boolean",
          "default": true,
          "values": {
            "on": "1",
            "off": "0"
          },
          "env": "AUTO_UPDATE"
        },
        {
          "key": "backupCount",
          "label": {
            "en": "Backup Count"
          },
          "type": "integer",
          "default": 4,
          "min": 0,
          "env": "BACKUP_COUNT"
        },
        {
          "key": "backupInterval",
          "label": {
            "en": "Backup Interval"
          },
          "type": "integer",
          "default": 1800,
          "min": 0,
          "env": "BACKUP_INTERVAL"
        },
        {
          "key": "backupLongtime",
          "label": {
            "en": "Backup Longtime"
          },
          "type": "integer",
          "default": 43200,
          "min": 0,
          "env": "BACKUP_LONGTIME"
        },
        {
          "key": "backupShorttime",
          "label": {
            "en": "Backup Shorttime"
          },
          "type": "integer",
          "default": 7200,
          "min": 0,
          "env": "BACKUP_SHORTTIME"
        },
        {
          "key": "enableCrossplay",
          "label": {
            "en": "Enable Crossplay"
          },
          "type": "boolean",
          "default": true,
          "values": {
            "on": "1",
            "off": "0"
          },
          "env": "ENABLE_CROSSPLAY"
        },
        {
          "key": "password",
          "label": {
            "en": "Server Password"
          },
          "type": "secret",
          "default": "secret",
          "pattern": "^.{5,20}$",
          "env": "PASSWORD"
        },
        {
          "key": "publicServer",
          "label": {
            "en": "Public Server"
          },
          "type": "boolean",
          "default": true,
          "values": {
            "on": "1",
            "off": "0"
          },
          "env": "PUBLIC_SERVER"
        },
        {
          "key": "serverName",
          "label": {
            "en": "Server Name"
          },
          "type": "string",
          "default": "My Server",
          "pattern": "^.{1,60}$",
          "env": "SERVER_NAME"
        },
        {
          "key": "srcdsBetaid",
          "label": {
            "en": "Beta Branch"
          },
          "type": "string",
          "default": "",
          "pattern": "^.{0,30}$",
          "env": "SRCDS_BETAID"
        },
        {
          "key": "srcdsBetapass",
          "label": {
            "en": "Beta Password"
          },
          "type": "secret",
          "default": "",
          "pattern": "^.{0,30}$",
          "env": "SRCDS_BETAPASS"
        },
        {
          "key": "world",
          "label": {
            "en": "World Name"
          },
          "type": "string",
          "default": "Dedicated",
          "pattern": "^.{1,20}$",
          "env": "WORLD"
        },
        {
          "key": "memory",
          "label": {
            "en": "Memory (MB)",
            "de": "Arbeitsspeicher (MB)"
          },
          "type": "integer",
          "default": 4096,
          "min": 1024,
          "max": 65536,
          "limit": "memory"
        }
      ],
      "lifecycle": {
        "ready": "DungeonDB Start",
        "stop": {
          "signal": "SIGINT"
        },
        "stopTimeoutSecs": 60
      },
      "capabilities": {
        "players": {
          "protocol": "a2s",
          "port": "query"
        },
        "backup": {
          "exclude": [
            "steamcmd",
            "steamapps",
            "linux64",
            "linux32",
            "valheim_server_Data",
            ".steam",
            "*.x86_64",
            "*.so",
            "*.sh"
          ]
        }
      }
    }
  ]
}
